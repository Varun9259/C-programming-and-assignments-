42️⃣ Write a C program to print all even numbers between 1 to 100 using a for loop and continue statement.

#include <stdio.h>
int main() {
    for(int i=1; i<=100; i++){
        if(i % 2 != 0)
            continue;  // Skip odd numbers
        
        printf("%d ", i); // Print even number
    }
    return 0;
}

